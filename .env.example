# ============================================================================
# Language Orchestrator - variables de entorno
#
# Copia este archivo a `.env` (misma raiz del repo) y ajusta los valores.
# El `.env` esta en .gitignore para no filtrar la API key.
#
# IMPORTANTE: no hay valores por defecto (por seguridad). Toda la variable
# REQUERIDA debe estar definida y no vacia; si falta alguna, el arranque
# falla indicando cuales faltan. Las OPCIONALES pueden omitirse o dejarse
# vacias.
# ============================================================================

# --- LLM: Docker Model Runner (http://localhost:12434/engines/v1) -----------

# REQUERIDA. Base URL del runner (OpenAI-compatible).
LLM_BASE_URL=http://localhost:12434/engines/v1

# REQUERIDA. ID exacto del modelo (ver: curl http://localhost:12434/engines/v1/models)
LLM_MODEL=

# OPCIONAL. API key de DMR (vacia si el runner no usa autenticacion).
LLM_API_KEY=

# OPCIONAL. Campos extra del request (JSON); si se define, se anade a cada
# request (vacia/ausente = sin campos extra). Con Qwen3 desactiva el thinking.
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# REQUERIDA. Temperatura de muestreo del LLM.
LLM_TEMPERATURE=0.7

# --- STT: ScribeCrate Live (hwdsl2/whisper-live-server) ---------------------

# REQUERIDA. Transporte: "websocket" (preferido) o "rest" (fallback).
STT_TRANSPORT=websocket

# REQUERIDA. WebSocket de ScribeCrate (el token de la API key se anade solo).
STT_WS_URL=ws://127.0.0.1:9090

# REQUERIDA. Base URL de la API REST OpenAI-compatible.
STT_REST_URL=http://127.0.0.1:8000

# OPCIONAL. API key (obtener: docker exec whisper-live whisper_live_manage --showkey)
STT_API_KEY=

# REQUERIDA. Modelo Whisper: tiny, base, small, medium, large-v1, large-v2,
# large-v3, large-v3-turbo, turbo (y variantes .en).
STT_MODEL=large-v3-turbo

# REQUERIDA. Idioma: "auto" (deteccion) o un codigo ("es", "en", ...).
STT_LANG=auto

# REQUERIDA. VAD del cliente WebSocket (true/false).
STT_USE_VAD=true

# --- Microfono / corte de frase ---------------------------------------------

# REQUERIDA. Piso del umbral RMS de silencio.
SILENCE_THRESHOLD=0.005

# REQUERIDA. Silencio (s) para terminar la frase.
SILENCE_SECONDS=1.0

# REQUERIDA. Duracion maxima (s) de grabacion por turno.
MAX_RECORD_SECONDS=30.0

# OPCIONAL. Indice del micro (si no, el default del sistema).
AUDIO_INPUT_DEVICE=

# --- Prompt / historial / flujo ---------------------------------------------

# REQUERIDA. System prompt del asistente.
SYSTEM_PROMPT=Eres un asistente de voz util y conciso. Responde de forma clara y breve, en el idioma del usuario.

# REQUERIDA. Turnos (usuario+asistente) a mantener en el historial.
HISTORY_TURNS=10

# REQUERIDA. Modo verbose (1/true, 0/false).
VERBOSE=1
